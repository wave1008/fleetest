{
  "id": "oi115-scrollto-under-keyboard",
  "finding": "キーボード表示中の ft_scroll_to が「scrolled to」と成功で返し、同じ応答の注記は同じ要素がキーボードの下と言う(OI-115)",
  "platform": "android",
  "redNote": "デバイスでも変異でもまだ確かめていない。直しを外した fleetest-mcp で形を撃ち、応答が赤になることを確かめる",
  "setup": [
    [
      "ft_launch",
      {
        "bundleId": "com.ftester.e2e.rn"
      }
    ]
  ],
  "reset": [
    [
      "ft_launch",
      {
        "bundleId": "com.ftester.e2e.rn"
      }
    ],
    [
      "ft_batch",
      {
        "steps": "tap '#nav_input'; tap '#field_password'"
      }
    ]
  ],
  "rounds": 3,
  "forms": [
    {
      "name": "キーボード表示中に ft_scroll_to '#field_multiline'",
      "steps": [
        [
          "ft_scroll_to",
          {
            "selector": "#field_multiline"
          }
        ]
      ],
      "allowErrors": true,
      "replyReject": [
        "scrolled to \"#field_multiline\""
      ]
    }
  ]
}
