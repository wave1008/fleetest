{
  "id": "oi58",
  "finding": "横向きの低い縦の一覧(Android)では、枠なしの払い(ブリッジ既定の始点)が一覧に当たらず scrollTo が「nothing moved at all」で失敗する。木に唯一の scrollable があれば、その中で払い直して続ける。容器が2つ以上の画面(E2E-Android のスクロール画面)では払い直さず scrollFrame を勧める",
  "platform": "android",
  "redConfirmed": true,
  "redNote": "修正を外した版(払い直しの分岐を無効にした fleetest-mcp)で 3/3 が「nothing moved at all」の赤、修正ありで 0/3(同じ Emulator・Pixel 10 Pro Android 17・E2EY-Flutter の横向きの #list_chat)",
  "setup": [
    [
      "ft_launch",
      {
        "bundleId": "com.ftester.e2ey.flutter"
      }
    ]
  ],
  "reset": [
    [
      "ft_batch",
      {
        "steps": "rotateTo orientation: .portrait"
      }
    ],
    [
      "ft_launch",
      {
        "bundleId": "com.ftester.e2ey.flutter"
      }
    ],
    [
      "ft_batch",
      {
        "steps": "tap '#nav_chat' scroll: .down"
      }
    ],
    [
      "ft_batch",
      {
        "steps": "rotateTo orientation: .landscape"
      }
    ]
  ],
  "resetSeconds": 1,
  "rounds": 5,
  "forms": [
    {
      "name": "枠なしの scrollTo(MCP)",
      "steps": [
        [
          "ft_scroll_to",
          {
            "selector": "#msg_50",
            "direction": "up",
            "maxSwipes": 15
          }
        ]
      ],
      "replyOnly": true,
      "replyReject": [
        "nothing moved at all"
      ]
    },
    {
      "name": "枠なしの scrollTo(DSL / ft_batch)",
      "steps": [
        [
          "ft_batch",
          {
            "steps": "scrollTo '#msg_50' direction: .up maxSwipes: 15"
          }
        ]
      ],
      "replyOnly": true,
      "replyReject": [
        "nothing moved at all"
      ]
    }
  ]
}
